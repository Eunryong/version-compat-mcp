{
  "name": "version-compat-mcp",
  "version": "0.1.0",
  "description": "Version-Aware Setup & Migration MCP Server for JS/TS ecosystems (Antigravity, Codex, Claude Code, Cursor)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eunryong/version-compat-mcp.git"
  },
  "homepage": "https://github.com/Eunryong/version-compat-mcp#readme",
  "bugs": {
    "url": "https://github.com/Eunryong/version-compat-mcp/issues"
  },
  "type": "module",
  "bin": {
    "version-compat-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "seed",
    "sources",
    "AGENTS.md",
    "GEMINI.md",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "smithery.yaml",
    "smithery.ts",
    "manifest.json",
    "glama.json"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js && npm run build:index",
    "build:ts": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "build:index": "node --no-warnings ./node_modules/tsx/dist/cli.mjs indexer/build.ts",
    "build:mcpb": "node -e 'const fs=require(\"fs\");const m=fs.readFileSync(\"manifest.json\",\"utf8\");fs.writeFileSync(\"manifest.json.bak\",m);const d=JSON.parse(m);d.tools.forEach(t=>delete t.inputSchema);fs.writeFileSync(\"manifest.json\",JSON.stringify(d,null,2));' && npx -y @anthropic-ai/mcpb pack . version-compat-mcp.mcpb && npx -y @anthropic-ai/mcpb clean version-compat-mcp.mcpb && mv manifest.json.bak manifest.json && zip version-compat-mcp.mcpb manifest.json",
    "prepack": "npm run build",
    "start": "node --no-warnings dist/index.js",
    "dev": "node --no-warnings ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "inspect": "npx -y @modelcontextprotocol/inspector node dist/index.js",
    "inspect:cli": "npx -y @modelcontextprotocol/inspector --cli node dist/index.js --method tools/list",
    "eval": "node --no-warnings ./node_modules/tsx/dist/cli.mjs eval/runEval.ts",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "antigravity",
    "codex",
    "cursor",
    "claude-code",
    "migration",
    "semver",
    "typescript",
    "nextjs",
    "tailwindcss",
    "eslint"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "semver": "^7.7.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
